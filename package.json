{
  "name": "shopping-budget-companion",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Mobile-first shopping budget companion with exact-money arithmetic, local-first persistence, accessibility, and evidence-driven release gates.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:check": "node scripts/validate-build.mjs",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run docs:check && npm run lint && npm run typecheck && npm run test:coverage && npm run build && npm run build:check",
    "typecheck": "tsc --noEmit",
    "qa:prepare-index": "node scripts/prepare-qa-index.mjs",
    "beta:prepare-index": "node scripts/prepare-beta-index.mjs",
    "docs:check": "node scripts/validate-docs.mjs",
    "cohort:prepare-index": "node scripts/prepare-cohort-index.mjs",
    "barcode:prepare-index": "node scripts/prepare-barcode-index.mjs",
    "test:coverage": "vitest run --coverage",
    "visual:prepare-index": "node scripts/prepare-visual-index.mjs",
    "ocr:prepare-index": "node scripts/prepare-ocr-index.mjs",
    "barcode-paired:prepare-index": "node scripts/prepare-barcode-paired-index.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tesseract.js": "7.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "fast-check": "4.10.2",
    "globals": "17.12.0",
    "jsdom": "30.1.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.1",
    "workbox-window": "7.4.1"
  },
  "engines": {
    "node": "24.x"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MykolaDotsenko/shopping-budget-companion.git"
  },
  "homepage": "https://mykoladotsenko.github.io/shopping-budget-companion/",
  "packageManager": "npm@11.19.0"
}
